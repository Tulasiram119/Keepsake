{
  "expo": {
    "name": "Keepsake",
    "slug": "keepsake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/friend_13350962.png",
    "scheme": "keepsake",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/friend_13350962.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/friend_13350962.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.tulasiram119.keepsake"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/friend_13350962.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/friend_13350962.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e30252da-b715-4e73-a56d-3430e5e2260d"
      }
    },
    "owner": "tulasiram119"
  }
}
